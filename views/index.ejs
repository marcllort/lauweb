<%- include('partials/header') %>

<!-- Hero Section -->
<section class="relative h-screen flex items-center justify-center overflow-hidden">
  <!-- Background Image/Video Placeholder -->
  <div class="absolute inset-0 bg-gradient-to-br from-sand-soft to-sand-tan">
    <!-- Replace this div with actual hero image or video -->
    <!-- Example: <img src="/assets/images/hero-bg.jpg" alt="Hero" class="w-full h-full object-cover"> -->
    <!-- Or video: <video autoplay muted loop class="w-full h-full object-cover"><source src="/assets/videos/hero.mp4" type="video/mp4"></video> -->
  </div>

  <!-- Overlay -->
  <div class="absolute inset-0 hero-overlay"></div>

  <!-- Hero Content -->
  <div class="relative z-10 text-center text-white px-6">
    <h1 class="text-5xl md:text-7xl font-bold mb-6 animate-fade-in">
      Journeys by Laura
    </h1>
    <p class="text-xl md:text-2xl mb-8 font-light animate-slide-up">
      Exploring the world, one adventure at a time
    </p>
    <div class="flex flex-col sm:flex-row gap-4 justify-center animate-slide-up">
      <a href="/guides" class="btn-primary">
        Explore My Guides
      </a>
      <a href="/maps" class="btn-secondary bg-white bg-opacity-20 border-white text-white hover:bg-white hover:text-sand-brown">
        View My Map
      </a>
    </div>
  </div>

  <!-- Scroll Indicator -->
  <div class="absolute bottom-8 left-1/2 transform -translate-x-1/2 animate-bounce">
    <svg class="w-6 h-6 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 14l-7 7m0 0l-7-7m7 7V3"></path>
    </svg>
  </div>
</section>

<!-- Introduction Section -->
<section class="py-20 bg-sand-white">
  <div class="container mx-auto px-6">
    <div class="max-w-3xl mx-auto text-center scroll-reveal">
      <h2 class="text-4xl font-bold text-sand-brown mb-6">
        Welcome to My Journey
      </h2>
      <p class="text-lg text-sand-brown leading-relaxed mb-8">
        Hey there! I'm Laura, a passionate traveler sharing authentic stories and practical tips
        from my adventures around the world. Whether you're looking for hidden gems, budget-friendly
        tips, or just some travel inspiration, you're in the right place.
      </p>
      <div class="flex justify-center">
        <img src="/assets/images/profile-placeholder.jpg" alt="Laura"
             class="w-48 h-48 rounded-full object-cover shadow-lg"
             onerror="this.src='data:image/svg+xml,%3Csvg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 200 200%22%3E%3Ccircle cx=%22100%22 cy=%22100%22 r=%22100%22 fill=%22%23D2B48C%22/%3E%3Ctext x=%22100%22 y=%22110%22 font-size=%2260%22 text-anchor=%22middle%22 fill=%22white%22%3EL%3C/text%3E%3C/svg%3E'">
      </div>
    </div>
  </div>
</section>

<!-- TikTok Integration Section -->
<section class="py-20 bg-sand-light">
  <div class="container mx-auto px-6">
    <div class="max-w-4xl mx-auto text-center scroll-reveal">
      <h2 class="text-4xl font-bold text-sand-brown mb-6">
        Follow My Adventures
      </h2>
      <p class="text-lg text-sand-brown mb-8">
        Get daily travel content, behind-the-scenes moments, and quick tips on TikTok!
      </p>

      <!-- TikTok Embed Placeholder -->
      <div class="bg-sand-white rounded-lg shadow-xl p-8 mb-8">
        <div class="aspect-video bg-gradient-to-br from-sand-soft to-sand-tan rounded-lg flex items-center justify-center">
          <!-- Replace with actual TikTok embed code -->
          <div class="text-center">
            <svg class="w-20 h-20 mx-auto mb-4 text-sand-brown" fill="currentColor" viewBox="0 0 24 24">
              <path d="M19.59 6.69a4.83 4.83 0 0 1-3.77-4.25V2h-3.45v13.67a2.89 2.89 0 0 1-5.2 1.74 2.89 2.89 0 0 1 2.31-4.64 2.93 2.93 0 0 1 .88.13V9.4a6.84 6.84 0 0 0-1-.05A6.33 6.33 0 0 0 5 20.1a6.34 6.34 0 0 0 10.86-4.43v-7a8.16 8.16 0 0 0 4.77 1.52v-3.4a4.85 4.85 0 0 1-1-.1z"/>
            </svg>
            <p class="text-sand-brown">TikTok embed will appear here</p>
          </div>
        </div>
      </div>

      <a href="https://www.tiktok.com/@yourhandle" target="_blank" rel="noopener noreferrer"
         class="btn-primary inline-block">
        Follow @yourhandle on TikTok
      </a>
    </div>
  </div>
</section>

<!-- Featured Content Section -->
<section class="py-20 bg-sand-white">
  <div class="container mx-auto px-6">
    <h2 class="text-4xl font-bold text-sand-brown text-center mb-12 scroll-reveal">
      Featured Content
    </h2>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-8 max-w-6xl mx-auto">
      <!-- Featured Guide -->
      <div class="card overflow-hidden scroll-reveal image-zoom">
        <div class="h-64 bg-gradient-to-br from-sand-tan to-sand-soft">
          <!-- Replace with actual image -->
          <!-- <img src="/assets/images/featured-guide.jpg" alt="Featured Guide" class="w-full h-full object-cover"> -->
          <div class="w-full h-full flex items-center justify-center text-sand-brown">
            <span class="text-lg">Featured Guide Image</span>
          </div>
        </div>
        <div class="p-6">
          <h3 class="text-2xl font-bold text-sand-brown mb-3">
            Ultimate Guide to Lisbon
          </h3>
          <p class="text-sand-brown mb-4">
            Discover the best cafes, viewpoints, and hidden gems in Portugal's stunning capital city.
          </p>
          <a href="/guides/lisbon" class="text-sand-tan font-semibold hover:underline">
            Read the Guide →
          </a>
        </div>
      </div>

      <!-- Featured Map Location -->
      <div class="card overflow-hidden scroll-reveal image-zoom">
        <div class="h-64 bg-gradient-to-br from-sand-soft to-sand-light">
          <!-- Replace with actual map screenshot or image -->
          <div class="w-full h-full flex items-center justify-center text-sand-brown">
            <span class="text-lg">Map Preview</span>
          </div>
        </div>
        <div class="p-6">
          <h3 class="text-2xl font-bold text-sand-brown mb-3">
            My Travel Pinpoints
          </h3>
          <p class="text-sand-brown mb-4">
            Explore all the amazing places I've been to on an interactive world map.
          </p>
          <a href="/maps" class="text-sand-tan font-semibold hover:underline">
            View the Map →
          </a>
        </div>
      </div>
    </div>
  </div>
</section>

<!-- Call to Action Section -->
<section class="py-20 bg-sand-tan text-white">
  <div class="container mx-auto px-6 text-center">
    <h2 class="text-4xl font-bold mb-6 scroll-reveal">
      Ready to Start Your Journey?
    </h2>
    <p class="text-xl mb-8 max-w-2xl mx-auto scroll-reveal">
      Dive into my travel guides, explore my map, and get inspired for your next adventure!
    </p>
    <div class="flex flex-col sm:flex-row gap-4 justify-center scroll-reveal">
      <a href="/guides" class="bg-white text-sand-tan px-8 py-4 rounded-lg font-semibold hover:bg-opacity-90 transition-all duration-300">
        Browse All Guides
      </a>
      <a href="https://www.tiktok.com/@yourhandle" target="_blank" rel="noopener noreferrer"
         class="border-2 border-white text-white px-8 py-4 rounded-lg font-semibold hover:bg-white hover:text-sand-tan transition-all duration-300">
        Follow on TikTok
      </a>
    </div>
  </div>
</section>

<%- include('partials/footer') %>
