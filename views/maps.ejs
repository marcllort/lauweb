<%- include('partials/header') %>

<!-- Hero Section -->
<section class="relative bg-gradient-to-br from-forest-green via-primary-blue to-blue-dark text-pure-white pt-32 pb-20 overflow-hidden">
  <!-- Pattern Overlay -->
  <div class="absolute inset-0 opacity-10 grid-pattern"></div>

  <div class="container-custom relative z-10">
    <div class="max-w-4xl mx-auto text-center">
      <span class="badge bg-pure-white/20 text-pure-white border border-pure-white/30 mb-6">
        Interactive Travel Map
      </span>

      <h1 class="text-5xl md:text-7xl font-outfit font-bold mb-6 leading-tight animate-fade-in">
        My Destinations
      </h1>

      <p class="text-xl md:text-2xl text-pure-white/90 max-w-2xl mx-auto animate-slide-up">
        Every pin tells a story. Explore the destinations I've visited and get inspired for your next adventure.
      </p>
    </div>
  </div>
</section>

<!-- Stats Section -->
<section class="section-padding bg-pure-white">
  <div class="container-custom">
    <div class="grid grid-cols-2 lg:grid-cols-4 gap-6 lg:gap-8">
      <div class="card text-center p-8 scroll-reveal">
        <div class="text-5xl lg:text-6xl font-outfit font-bold gradient-text mb-3">25+</div>
        <div class="text-slate text-sm uppercase tracking-wider">Countries Explored</div>
      </div>
      <div class="card text-center p-8 scroll-reveal">
        <div class="text-5xl lg:text-6xl font-outfit font-bold gradient-text mb-3">100+</div>
        <div class="text-slate text-sm uppercase tracking-wider">Cities Visited</div>
      </div>
      <div class="card text-center p-8 scroll-reveal">
        <div class="text-5xl lg:text-6xl font-outfit font-bold gradient-text mb-3">3</div>
        <div class="text-slate text-sm uppercase tracking-wider">Continents</div>
      </div>
      <div class="card text-center p-8 scroll-reveal">
        <div class="text-5xl lg:text-6xl font-outfit font-bold gradient-text mb-3">∞</div>
        <div class="text-slate text-sm uppercase tracking-wider">Memories Made</div>
      </div>
    </div>
  </div>
</section>

<!-- Interactive Map Section -->
<section class="section-padding bg-broken-white">
  <div class="container-custom">
    <!-- Section Header -->
    <div class="text-center mb-12 scroll-reveal">
      <h2 class="text-4xl md:text-5xl font-outfit font-bold text-charcoal mb-6">
        Explore the Map
      </h2>
      <p class="text-lg text-slate max-w-2xl mx-auto">
        Click on any pin to see location details, photos, and links to my detailed guides.
      </p>
    </div>

    <!-- Map Container -->
    <div class="card shadow-strong scroll-reveal">
      <div class="relative" style="padding-bottom: 60%; height: 0;">
        <!-- Google Maps Embed -->
        <!--
          SETUP INSTRUCTIONS:
          1. Visit https://www.google.com/mymaps
          2. Create your custom map with pins
          3. Add titles, descriptions, and photos to each pin
          4. Make the map public (Share > Get link > Anyone with link)
          5. Get embed code (Menu > Embed on my site)
          6. Replace the iframe below with your embed code
        -->

        <iframe
          src="https://www.google.com/maps/d/embed?mid=YOUR_MAP_ID_HERE&ehbc=2E312F"
          width="100%"
          height="100%"
          style="position: absolute; top: 0; left: 0; border: 0; border-radius: 1rem;"
          allowfullscreen=""
          loading="lazy"
          referrerpolicy="no-referrer-when-downgrade"
          title="Laura's Travel Destinations">
        </iframe>

        <!-- Fallback Placeholder -->
        <div style="position: absolute; top: 0; left: 0; right: 0; bottom: 0; display: flex; align-items: center; justify-center; border-radius: 1rem;" class="img-placeholder">
          <div class="text-center p-8">
            <svg class="w-20 h-20 mx-auto mb-6 text-primary-blue" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/>
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/>
            </svg>
            <h3 class="text-2xl font-outfit font-bold text-charcoal mb-3">Interactive Map</h3>
            <p class="text-slate max-w-md mx-auto">
              Add your Google My Maps embed code to display your travel destinations here.
            </p>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

