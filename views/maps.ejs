<%- include('partials/header') %>

<!-- Maps Hero Section -->
<section class="bg-sand-tan text-white py-20">
  <div class="container mx-auto px-6 text-center">
    <h1 class="text-5xl md:text-6xl font-bold mb-6 animate-fade-in">
      My Pinpoints
    </h1>
    <p class="text-xl md:text-2xl font-light max-w-3xl mx-auto animate-slide-up">
      Every pin tells a story. Explore the places I've visited and get inspired for your next adventure.
    </p>
  </div>
</section>

<!-- Map Instructions Section -->
<section class="py-12 bg-sand-white">
  <div class="container mx-auto px-6">
    <div class="max-w-4xl mx-auto text-center scroll-reveal">
      <h2 class="text-3xl font-bold text-sand-brown mb-4">
        How to Use the Map
      </h2>
      <p class="text-lg text-sand-brown leading-relaxed">
        Click on any pin to see the location details and photos. Each marker represents a destination
        I've explored and shared. Some pins might link directly to detailed guides!
      </p>
    </div>
  </div>
</section>

<!-- Interactive Map Section -->
<section class="py-12 bg-sand-light">
  <div class="container mx-auto px-6">
    <div class="max-w-7xl mx-auto">
      <div class="bg-sand-white rounded-lg shadow-xl overflow-hidden scroll-reveal">
        <!-- Google Maps Embed -->
        <div class="map-container" style="position: relative; padding-bottom: 60%; height: 0; overflow: hidden;">
          <!--
            INSTRUCTIONS TO SET UP GOOGLE MAPS:
            1. Go to https://www.google.com/mymaps
            2. Create a new map or open an existing one
            3. Add pins to your desired locations with titles and descriptions
            4. Click on "Share" and make the map public
            5. Get the embed code (click the three dots menu > "Embed on my site")
            6. Replace the iframe below with your embed code
          -->

          <!-- Placeholder Map - Replace with actual Google My Maps embed -->
          <iframe
            src="https://www.google.com/maps/d/embed?mid=YOUR_MAP_ID_HERE&ehbc=2E312F"
            width="100%"
            height="100%"
            style="position: absolute; top: 0; left: 0; border: 0;"
            allowfullscreen=""
            loading="lazy"
            referrerpolicy="no-referrer-when-downgrade"
            title="Laura's Travel Map">
          </iframe>

          <!-- Fallback content if map doesn't load -->
          <div style="position: absolute; top: 0; left: 0; right: 0; bottom: 0; display: flex; align-items: center; justify-content: center; background: linear-gradient(135deg, #EADDCA 0%, #D2B48C 100%); pointer-events: none;">
            <div class="text-center p-8">
              <svg class="w-20 h-20 mx-auto mb-4 text-sand-brown" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"></path>
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"></path>
              </svg>
              <h3 class="text-2xl font-bold text-sand-brown mb-2">Interactive Map Coming Soon</h3>
              <p class="text-sand-brown">Replace this placeholder with your Google My Maps embed code</p>
            </div>
          </div>
        </div>
      </div>

      <!-- Map Stats -->
      <div class="grid grid-cols-2 md:grid-cols-4 gap-6 mt-12">
        <div class="bg-sand-white rounded-lg shadow-md p-6 text-center scroll-reveal">
          <div class="text-4xl font-bold text-sand-tan mb-2">15+</div>
          <div class="text-sand-brown">Countries</div>
        </div>
        <div class="bg-sand-white rounded-lg shadow-md p-6 text-center scroll-reveal">
          <div class="text-4xl font-bold text-sand-tan mb-2">50+</div>
          <div class="text-sand-brown">Cities</div>
        </div>
        <div class="bg-sand-white rounded-lg shadow-md p-6 text-center scroll-reveal">
          <div class="text-4xl font-bold text-sand-tan mb-2">3</div>
          <div class="text-sand-brown">Continents</div>
        </div>
        <div class="bg-sand-white rounded-lg shadow-md p-6 text-center scroll-reveal">
          <div class="text-4xl font-bold text-sand-tan mb-2">∞</div>
          <div class="text-sand-brown">Memories</div>
        </div>
      </div>
    </div>
  </div>
</section>

<!-- Featured Destinations -->
<section class="py-20 bg-sand-white">
  <div class="container mx-auto px-6">
    <h2 class="text-4xl font-bold text-sand-brown text-center mb-12 scroll-reveal">
      Featured Destinations
    </h2>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-8 max-w-6xl mx-auto">
      <!-- Destination Card 1 -->
      <div class="card overflow-hidden scroll-reveal image-zoom">
        <div class="h-48 bg-gradient-to-br from-sand-tan to-sand-soft">
          <div class="w-full h-full flex items-center justify-center text-sand-brown">
            <span>Destination Photo</span>
          </div>
        </div>
        <div class="p-6">
          <h3 class="text-xl font-bold text-sand-brown mb-2">Lisbon, Portugal</h3>
          <p class="text-sand-brown text-sm mb-3">
            Charming hills, colorful tiles, and the best pastéis de nata you'll ever taste.
          </p>
          <a href="/guides/lisbon" class="text-sand-tan font-semibold text-sm hover:underline">
            Read Guide →
          </a>
        </div>
      </div>

      <!-- Destination Card 2 -->
      <div class="card overflow-hidden scroll-reveal image-zoom">
        <div class="h-48 bg-gradient-to-br from-sand-soft to-sand-light">
          <div class="w-full h-full flex items-center justify-center text-sand-brown">
            <span>Destination Photo</span>
          </div>
        </div>
        <div class="p-6">
          <h3 class="text-xl font-bold text-sand-brown mb-2">Barcelona, Spain</h3>
          <p class="text-sand-brown text-sm mb-3">
            Gaudí's masterpieces, beach vibes, and tapas that will change your life.
          </p>
          <a href="/guides/barcelona" class="text-sand-tan font-semibold text-sm hover:underline">
            Read Guide →
          </a>
        </div>
      </div>

      <!-- Destination Card 3 -->
      <div class="card overflow-hidden scroll-reveal image-zoom">
        <div class="h-48 bg-gradient-to-br from-sand-tan to-sand-soft">
          <div class="w-full h-full flex items-center justify-center text-sand-brown">
            <span>Destination Photo</span>
          </div>
        </div>
        <div class="p-6">
          <h3 class="text-xl font-bold text-sand-brown mb-2">Paris, France</h3>
          <p class="text-sand-brown text-sm mb-3">
            Romance, croissants, and hidden gems beyond the Eiffel Tower.
          </p>
          <a href="/guides/paris" class="text-sand-tan font-semibold text-sm hover:underline">
            Read Guide →
          </a>
        </div>
      </div>
    </div>
  </div>
</section>

<!-- Call to Action -->
<section class="py-16 bg-sand-tan text-white">
  <div class="container mx-auto px-6 text-center">
    <h2 class="text-3xl font-bold mb-4 scroll-reveal">
      Want to See More?
    </h2>
    <p class="text-lg mb-6 scroll-reveal">
      Check out my detailed travel guides for tips, itineraries, and insider recommendations.
    </p>
    <a href="/guides" class="btn-primary bg-white text-sand-tan hover:bg-opacity-90 inline-block scroll-reveal">
      Browse My Guides
    </a>
  </div>
</section>

<%- include('partials/footer') %>
