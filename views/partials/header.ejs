<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="description" content="Journeys by Laura - Curated travel experiences and authentic stories from around the world">
  <link rel="icon" type="image/svg+xml" href="/icon.svg">
  <title><%= title %></title>
  <link rel="stylesheet" href="/css/style.css">
</head>
<body class="font-sans">
  <!-- Loading Animation -->
  <div id="loader" class="fixed inset-0 bg-broken-white flex items-center justify-center z-50 transition-opacity duration-500">
    <div class="loader"></div>
  </div>

  <!-- Navigation - Ultra Clean -->
  <nav class="bg-pure-white border-b border-border-gray" id="navbar">
    <div class="max-w-7xl mx-auto px-6">
      <div class="flex items-center justify-between h-16">

        <!-- Logo with Icon -->
        <a href="/" class="flex items-center gap-3 group">
          <img src="/icon.svg" alt="Laura" class="w-8 h-8 transition-transform duration-300 group-hover:scale-110">
          <span class="text-lg font-heading font-bold text-charcoal">Laura</span>
        </a>

        <!-- Desktop Navigation -->
        <div class="hidden md:flex items-center gap-8">
          <a href="/" class="text-sm text-charcoal hover:text-primary-blue transition-colors <%= currentPage === 'home' ? 'font-semibold text-primary-blue' : '' %>">
            Home
          </a>
          <a href="/maps" class="text-sm text-charcoal hover:text-primary-blue transition-colors <%= currentPage === 'maps' ? 'font-semibold text-primary-blue' : '' %>">
            Destinations
          </a>
          <a href="/guides" class="text-sm text-charcoal hover:text-primary-blue transition-colors <%= currentPage === 'guides' ? 'font-semibold text-primary-blue' : '' %>">
            Guides
          </a>
          <a href="https://www.tiktok.com/@yourhandle" target="_blank" rel="noopener noreferrer"
             class="ml-4 px-5 py-2 bg-forest-green text-pure-white text-sm rounded-lg hover:bg-green-dark transition-all duration-300">
            Follow
          </a>
        </div>

        <!-- Mobile Menu Button -->
        <button id="mobile-menu-btn" class="md:hidden text-charcoal">
          <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path id="menu-icon" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"></path>
            <path id="close-icon" class="hidden" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
          </svg>
        </button>
      </div>
    </div>

    <!-- Mobile Navigation -->
    <div id="mobile-menu" class="hidden md:hidden border-t border-border-gray bg-pure-white">
      <div class="px-6 py-4 space-y-3">
        <a href="/" class="block text-sm text-charcoal hover:text-primary-blue <%= currentPage === 'home' ? 'font-semibold text-primary-blue' : '' %>">
          Home
        </a>
        <a href="/maps" class="block text-sm text-charcoal hover:text-primary-blue <%= currentPage === 'maps' ? 'font-semibold text-primary-blue' : '' %>">
          Destinations
        </a>
        <a href="/guides" class="block text-sm text-charcoal hover:text-primary-blue <%= currentPage === 'guides' ? 'font-semibold text-primary-blue' : '' %>">
          Guides
        </a>
        <a href="https://www.tiktok.com/@yourhandle" target="_blank" rel="noopener noreferrer"
           class="block px-5 py-2 bg-forest-green text-pure-white text-sm rounded-lg text-center hover:bg-green-dark transition-all">
          Follow on TikTok
        </a>
      </div>
    </div>
  </nav>

  <!-- Main Content -->
  <main class="page-transition">
