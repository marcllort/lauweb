<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="description" content="Journeys by Laura - Travel stories, guides, and adventures from around the world">
  <title><%= title %></title>
  <link rel="stylesheet" href="/css/style.css">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
</head>
<body class="font-montserrat">
  <!-- Loading Animation -->
  <div id="loader" class="fixed inset-0 bg-sand-light flex items-center justify-center z-50 transition-opacity duration-500">
    <div class="loader"></div>
  </div>

  <!-- Navigation -->
  <nav class="bg-sand-white shadow-md sticky top-0 z-40 transition-all duration-300">
    <div class="container mx-auto px-6 py-4">
      <div class="flex items-center justify-between">
        <!-- Logo/Brand -->
        <a href="/" class="text-2xl font-bold text-sand-brown hover:text-sand-tan transition-colors duration-300">
          Journeys by Laura
        </a>

        <!-- Desktop Navigation -->
        <div class="hidden md:flex items-center space-x-8">
          <a href="/" class="nav-link <%= currentPage === 'home' ? 'active' : '' %>">
            Home
          </a>
          <a href="/maps" class="nav-link <%= currentPage === 'maps' ? 'active' : '' %>">
            My Pinpoints
          </a>
          <a href="/guides" class="nav-link <%= currentPage === 'guides' ? 'active' : '' %>">
            My Guides
          </a>
          <a href="https://www.tiktok.com/@yourhandle" target="_blank" rel="noopener noreferrer"
             class="btn-primary">
            Follow on TikTok
          </a>
        </div>

        <!-- Mobile Menu Button -->
        <button id="mobile-menu-btn" class="md:hidden text-sand-brown focus:outline-none">
          <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"></path>
          </svg>
        </button>
      </div>

      <!-- Mobile Navigation -->
      <div id="mobile-menu" class="hidden md:hidden mt-4 pb-4">
        <div class="flex flex-col space-y-4">
          <a href="/" class="text-sand-brown hover:text-sand-tan transition-colors duration-300 <%= currentPage === 'home' ? 'font-bold' : '' %>">
            Home
          </a>
          <a href="/maps" class="text-sand-brown hover:text-sand-tan transition-colors duration-300 <%= currentPage === 'maps' ? 'font-bold' : '' %>">
            My Pinpoints
          </a>
          <a href="/guides" class="text-sand-brown hover:text-sand-tan transition-colors duration-300 <%= currentPage === 'guides' ? 'font-bold' : '' %>">
            My Guides
          </a>
          <a href="https://www.tiktok.com/@yourhandle" target="_blank" rel="noopener noreferrer"
             class="btn-primary inline-block text-center">
            Follow on TikTok
          </a>
        </div>
      </div>
    </div>
  </nav>

  <!-- Main Content -->
  <main class="page-transition">
