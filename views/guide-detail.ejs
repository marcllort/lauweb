<%- include('partials/header') %>

<!-- Guide Hero -->
<section class="relative h-96 flex items-center justify-center overflow-hidden">
  <div class="absolute inset-0 bg-gradient-to-br from-sand-tan to-sand-brown">
    <!-- Replace with actual guide hero image -->
  </div>
  <div class="absolute inset-0 hero-overlay"></div>
  <div class="relative z-10 text-center text-white px-6">
    <div class="mb-4">
      <span class="bg-white bg-opacity-20 px-4 py-2 rounded-full text-sm font-semibold">
        City Guide
      </span>
    </div>
    <h1 class="text-4xl md:text-5xl font-bold mb-4 animate-fade-in">
      Ultimate Guide to Lisbon
    </h1>
    <p class="text-lg animate-slide-up">Last updated: November 2025 • 8 min read</p>
  </div>
</section>

<!-- Guide Content -->
<article class="py-16 bg-sand-white">
  <div class="container mx-auto px-6">
    <div class="max-w-4xl mx-auto">

      <!-- Introduction -->
      <div class="prose prose-lg max-w-none mb-12 scroll-reveal">
        <p class="text-xl text-sand-brown leading-relaxed">
          Lisbon stole my heart from the moment I arrived. With its colorful tiles, stunning viewpoints,
          and incredible food scene, Portugal's capital is a must-visit destination. Here's everything
          you need to know to make the most of your trip!
        </p>
      </div>

      <!-- Quick Tips Section -->
      <div class="bg-sand-light rounded-lg p-8 mb-12 scroll-reveal">
        <h2 class="text-2xl font-bold text-sand-brown mb-6">Quick Tips</h2>
        <ul class="space-y-3">
          <li class="flex items-start">
            <span class="text-sand-tan mr-3 text-xl">✓</span>
            <span class="text-sand-brown">Get a rechargeable Viva Viagem card for public transport</span>
          </li>
          <li class="flex items-start">
            <span class="text-sand-tan mr-3 text-xl">✓</span>
            <span class="text-sand-brown">Wear comfortable shoes - Lisbon is very hilly!</span>
          </li>
          <li class="flex items-start">
            <span class="text-sand-tan mr-3 text-xl">✓</span>
            <span class="text-sand-brown">Try pastéis de nata from Pastéis de Belém (worth the queue!)</span>
          </li>
          <li class="flex items-start">
            <span class="text-sand-tan mr-3 text-xl">✓</span>
            <span class="text-sand-brown">Visit viewpoints (miradouros) during golden hour for best photos</span>
          </li>
        </ul>
      </div>

      <!-- Top 5 Section -->
      <div class="mb-12 scroll-reveal">
        <h2 class="text-3xl font-bold text-sand-brown mb-8">Top 5 Things to Do</h2>
        <div class="space-y-6">

          <div class="card p-6">
            <div class="flex items-start">
              <div class="bg-sand-tan text-white rounded-full w-10 h-10 flex items-center justify-center font-bold mr-4 flex-shrink-0">
                1
              </div>
              <div>
                <h3 class="text-xl font-bold text-sand-brown mb-2">Explore Alfama District</h3>
                <p class="text-sand-brown">
                  Get lost in the oldest neighborhood in Lisbon. Wander through narrow streets,
                  discover hidden viewpoints, and listen to traditional Fado music in the evening.
                </p>
              </div>
            </div>
          </div>

          <div class="card p-6">
            <div class="flex items-start">
              <div class="bg-sand-tan text-white rounded-full w-10 h-10 flex items-center justify-center font-bold mr-4 flex-shrink-0">
                2
              </div>
              <div>
                <h3 class="text-xl font-bold text-sand-brown mb-2">Ride Tram 28</h3>
                <p class="text-sand-brown">
                  Take the iconic yellow tram through Lisbon's historic neighborhoods.
                  Go early in the morning to avoid crowds!
                </p>
              </div>
            </div>
          </div>

          <div class="card p-6">
            <div class="flex items-start">
              <div class="bg-sand-tan text-white rounded-full w-10 h-10 flex items-center justify-center font-bold mr-4 flex-shrink-0">
                3
              </div>
              <div>
                <h3 class="text-xl font-bold text-sand-brown mb-2">Visit Belém</h3>
                <p class="text-sand-brown">
                  See the iconic Belém Tower and Jerónimos Monastery, then grab those famous
                  pastéis de nata from the original bakery.
                </p>
              </div>
            </div>
          </div>

          <div class="card p-6">
            <div class="flex items-start">
              <div class="bg-sand-tan text-white rounded-full w-10 h-10 flex items-center justify-center font-bold mr-4 flex-shrink-0">
                4
              </div>
              <div>
                <h3 class="text-xl font-bold text-sand-brown mb-2">Sunset at Miradouro da Senhora do Monte</h3>
                <p class="text-sand-brown">
                  My favorite viewpoint in Lisbon! Bring a bottle of wine and watch the sunset
                  over the city with locals.
                </p>
              </div>
            </div>
          </div>

          <div class="card p-6">
            <div class="flex items-start">
              <div class="bg-sand-tan text-white rounded-full w-10 h-10 flex items-center justify-center font-bold mr-4 flex-shrink-0">
                5
              </div>
              <div>
                <h3 class="text-xl font-bold text-sand-brown mb-2">LX Factory</h3>
                <p class="text-sand-brown">
                  A creative hub filled with street art, trendy cafes, bookstores, and shops.
                  Perfect for a laid-back afternoon.
                </p>
              </div>
            </div>
          </div>

        </div>
      </div>

      <!-- Photo Gallery Placeholder -->
      <div class="mb-12 scroll-reveal">
        <h2 class="text-3xl font-bold text-sand-brown mb-8">Photo Gallery</h2>
        <div class="grid grid-cols-2 md:grid-cols-3 gap-4">
          <div class="aspect-square bg-gradient-to-br from-sand-tan to-sand-soft rounded-lg image-zoom"></div>
          <div class="aspect-square bg-gradient-to-br from-sand-soft to-sand-light rounded-lg image-zoom"></div>
          <div class="aspect-square bg-gradient-to-br from-sand-light to-sand-tan rounded-lg image-zoom"></div>
          <div class="aspect-square bg-gradient-to-br from-sand-tan to-sand-brown rounded-lg image-zoom"></div>
          <div class="aspect-square bg-gradient-to-br from-sand-soft to-sand-tan rounded-lg image-zoom"></div>
          <div class="aspect-square bg-gradient-to-br from-sand-light to-sand-soft rounded-lg image-zoom"></div>
        </div>
      </div>

      <!-- Budget Tips -->
      <div class="bg-sand-tan text-white rounded-lg p-8 mb-12 scroll-reveal">
        <h2 class="text-2xl font-bold mb-6">Budget Tips</h2>
        <div class="space-y-4">
          <div class="flex items-start">
            <span class="mr-3 text-xl">💰</span>
            <p>Eat at local tascas (traditional restaurants) for authentic food at great prices</p>
          </div>
          <div class="flex items-start">
            <span class="mr-3 text-xl">💰</span>
            <p>Skip the hop-on-hop-off bus and use public transport or walk instead</p>
          </div>
          <div class="flex items-start">
            <span class="mr-3 text-xl">💰</span>
            <p>Many museums offer free entry on the first Sunday of each month</p>
          </div>
        </div>
      </div>

      <!-- Navigation to other guides -->
      <div class="border-t border-sand-soft pt-12 scroll-reveal">
        <h3 class="text-2xl font-bold text-sand-brown mb-6">More Guides You'll Love</h3>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
          <a href="/guides/barcelona-food" class="card p-6 hover:shadow-xl transition-all">
            <h4 class="text-xl font-bold text-sand-brown mb-2">Barcelona Food Tour</h4>
            <p class="text-sand-brown text-sm">Discover the best tapas bars and local markets</p>
          </a>
          <a href="/guides/europe-budget" class="card p-6 hover:shadow-xl transition-all">
            <h4 class="text-xl font-bold text-sand-brown mb-2">Europe on a Budget</h4>
            <p class="text-sand-brown text-sm">Travel tips to save money across Europe</p>
          </a>
        </div>
      </div>

    </div>
  </div>
</article>

<!-- Back to Guides -->
<section class="py-12 bg-sand-light">
  <div class="container mx-auto px-6 text-center">
    <a href="/guides" class="btn-secondary inline-block">
      ← Back to All Guides
    </a>
  </div>
</section>

<%- include('partials/footer') %>
